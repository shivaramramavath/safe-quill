# Server configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Redis (Guest session store & Analysis cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres (Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=safequill
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safequill?schema=public

# Fast ML Service
ML_SERVICE_URL=http://localhost:8000

# Groq LLM (Required in Phase 4)
GROQ_API_KEY=gsk_placeholder_for_phase_4

# Brevo Mailer (Required in Phase 5)
BREVO_API_KEY=xkeysib_placeholder_for_phase_5
BREVO_SENDER_EMAIL=noreply@safequill.local

# JWT Secret
JWT_SECRET=super_secret_safequill_session_key_phase_1
