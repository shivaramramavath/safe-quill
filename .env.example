# ==========================================
# SafeQuill Production / Development Environment
# ==========================================

# Server & Network Configuration
NODE_ENV=production
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Redis (Guest session store, Rate Limiting & Analysis cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# MongoDB Atlas Cloud Database
# ==========================================
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/safequill?retryWrites=true&w=majority&appName=<cluster-name>
# Example:
# MONGODB_URI=mongodb+srv://safequill_admin:MySecurePassword123@cluster0.abcde.mongodb.net/safequill?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/safequill?retryWrites=true&w=majority

# ==========================================
# Machine Learning Service (FastAPI)
# ==========================================
ML_SERVICE_URL=http://localhost:8000

# ==========================================
# Groq Cloud LLM (for LangGraph AI Rewriting & Tone Analysis)
# ==========================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# ==========================================
# Brevo (Sendinblue) Transactional Mailer & Security Alerts
# ==========================================
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@safequill.local

# ==========================================
# JWT Secret for User Authentication
# ==========================================
JWT_SECRET=replace_with_a_secure_random_64_character_secret_string
