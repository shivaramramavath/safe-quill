# Server configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Redis (Guest session store & Analysis cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (Persistent storage for claimed accounts & saved analyses)
MONGODB_URI=mongodb://localhost:27017/safequill
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=safequill_secret

# Fast ML Service
ML_SERVICE_URL=http://localhost:8000

# Groq LLM (Required in Phase 4)
GROQ_API_KEY=gsk_placeholder_for_phase_4

# Brevo Mailer (Required in Phase 5)
BREVO_API_KEY=xkeysib_placeholder_for_phase_5
BREVO_SENDER_EMAIL=noreply@safequill.local

# JWT Secret
JWT_SECRET=super_secret_safequill_session_key_phase_1
